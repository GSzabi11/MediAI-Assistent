# MediAI — közös beállítások egy helyen.
# Másold le `.env` néven a repó gyökerébe (a .env gitignore-olva van, ez a sablon nem), és töltsd ki.
# Mindegyik szolgáltatás ezt olvassa: Spring (backend/), Python (ai-service/docproc, ai-service/voice),
# Docker Compose (compose.yaml), Vite (frontend/). A valódi környezeti változó mindig felülírja.
#
# Formátum: KULCS=érték, idézőjel nélkül. Windows-utat perjellel írj (C:/Users/...): a Spring
# properties-ként olvassa, ott a \ escape-karakter.

# ---------------------------------------------------------------------------
# Spring ↔ Python közös titok (kötelező, mindkét oldalon ugyanaz).
# Generálás pl.: python -c "import secrets; print(secrets.token_urlsafe(32))"
MEDIAI_AI_TOKEN=

# ---------------------------------------------------------------------------
# Adatbázis (compose.yaml + Spring)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mydatabase
POSTGRES_PORT=5433

# ---------------------------------------------------------------------------
# Spring → Python és vissza
MEDIAI_AI_SERVICE_URL=http://localhost:8001
MEDIAI_CALLBACK_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Dokumentum-feldolgozó (ai-service/docproc) — ld. ai-service/docproc/README.md
DOCPROC_HOST=127.0.0.1
DOCPROC_PORT=8001
# Ha megadod: csak ez alatti fájl olvasható (a Spring documents-dir-je, abszolút úttal), pl.
# MEDIAI_DOCUMENTS_ROOT=C:/Users/<te>/Desktop/MediAI-Assistent/backend/data/documents
OLLAMA_URL=http://localhost:11434
DOC_LLM_MODEL=medgemma:4b
# A chat modellje; üresen = DOC_LLM_MODEL (ajánlott: qwen3.5:9b, ld. docs/clinical-chat.md)
CHAT_LLM_MODEL=
DOC_LLM_SEED=42
DOC_LLM_NUM_CTX=16384
DOC_LLM_TIMEOUT_SEC=600
DOC_LLM_MAX_OUTPUT_TOKENS=4096
DOC_LLM_MAX_CHARS=40000
# Kötelező: az Ollamában letöltött embedding-modell (ollama pull qwen3-embedding:4b). Nincs
# Hugging Face-letöltés; 1024 dimre kérjük (a document_chunk.embedding vector(1024)).
# Modellváltás után a régi dokumentumokat újra kell feldolgozni (a keresés modellenként szűr).
EMBEDDING_MODEL=qwen3-embedding:4b
CHUNK_TARGET_CHARS=800
CHUNK_OVERLAP_CHARS=150

# ---------------------------------------------------------------------------
# Hangmodul (ai-service/voice) — a CLI-prototípus és a hangszolgáltatás (service.py, docs/voice-module.md)
MEDIAI_VOICE_SERVICE_URL=http://localhost:8002
VOICE_HOST=127.0.0.1
VOICE_PORT=8002
# Ha megadod: csak ez alatti hangprofil-minta olvasható (a Spring data/voice-a, abszolút úttal); a
# felvételek a MEDIAI_DOCUMENTS_ROOT alatt vannak (data/documents/{beteg}/hangfelvetelek/), pl.
# MEDIAI_VOICE_ROOT=C:/Users/<te>/Desktop/MediAI-Assistent/backend/data/voice
# Az átirat MedGemma-átnézésének, a kulcsszavaknak és az összefoglalónak a modellje; üresen = LLM_MODEL
# (mérve: medgemma:latest jobb volt, mint a medgemma1.5:4b — docs/voice-module.md)
VOICE_REVIEW_MODEL=
# Helyi modellek mappája (download_models.py tölti, futás közben nincs letöltés); üresen ai-service/models
MEDIAI_MODELS_DIR=
# Hugging Face token a pyannote-modellekhez (NEM azonos a MEDIAI_AI_TOKEN-nel)
HF_TOKEN=
ASR_MODEL=large-v3
LLM_MODEL=medgemma:4b
# laza / szigoru
EXTRACT_MODE=laza
LLM_DEADLINE=120

# ---------------------------------------------------------------------------
# Frontend (Vite) — csak a VITE_ előtagú kerül a böngészőbe, titkot oda ne tegyél
VITE_API_BASE=/api
MEDIAI_PROXY_TARGET=http://localhost:8080
